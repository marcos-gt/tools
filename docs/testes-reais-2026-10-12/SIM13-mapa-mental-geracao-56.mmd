mindmap
  root((Relações entre entidades))
    cliente((Cliente contém id_cliente como chave primária e nome_cliente como atributo descritivo.))
    pedido((Pedido contém id_pedido como chave primária e id_cliente como referência ao cliente.))
    produto((Produto contém id_produto como chave primária e descricao_produto como atributo descritivo.))
    itemPedido((ItemPedido contém referências ao pedido e ao produto presentes no item.))
    quantidade((A quantidade é um atributo do item de pedido no exemplo sintético.))
    preçoRegistado((O preço registrado no item é preservado como informação do pedido no momento do registro.))
    clienteMuitosPedidos((Um cliente pode possuir vários pedidos no relacionamento descrito.))
    pedidoMuitosItens((Um pedido pode possuir vários itens de pedido no relacionamento descrito.))
    produtoEmDiferentesItens((Um produto pode aparecer em diferentes itens de pedido, sem duplicar seu cadastro.))
    registroItem((Para registrar um item, verificar se o pedido e o produto existem.))
   RegistrarItem((Quando as referências existirem e a quantidade for positiva, registrar o item de pedido.))
    RejeitarItem((Quando alguma referência faltar ou a quantidade não for positiva, rejeitar o item.))