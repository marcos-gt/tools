DJANGO_SECRET_KEY=senha
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=tcc
DB_USER=tcc
DB_PASSWORD=configure-localmente
DB_HOST=127.0.0.1
DB_PORT=5432
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_READ_TIMEOUT=120
OLLAMA_TOKEN=
# 0 desativa o limite de caracteres; nunca trunca mensagens.
OLLAMA_MAX_INPUT_CHARS=0
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0


# Emails: SMTP genérico; para Gmail, use EMAIL_PROVIDER=gmail.
# O remetente padrão é EMAIL_HOST_USER. Preencha uma senha de aplicativo/credencial SMTP.
SITE_NAME=Sistema de Chat
PUBLIC_SITE_URL=http://127.0.0.1:8000
EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=15
PASSWORD_RESET_TIMEOUT=3600
AUTH_EMAIL_COOLDOWN=60
AUTH_EMAIL_MAX_PER_IP=10

# Resposta direta; vazio usa o modo padrao do modelo.
OLLAMA_THINK=false
